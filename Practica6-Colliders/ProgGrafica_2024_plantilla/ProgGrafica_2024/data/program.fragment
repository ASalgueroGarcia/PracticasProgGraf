#version 330

uniform vec3 lightPosition;
uniform vec3 lightColor;
uniform float lightKa;
uniform float lightKd;
uniform float lightKs;

uniform int usaTextura;
uniform int shiny;
uniform float materialAlpha;
uniform float materialKa;
uniform float materialKd;
uniform float materialKs;

uniform sampler2D textureData;

in vec4 fColor;
in vec3 fNormal;
in vec2 fTexCoord;
in vec3 fWorldPos;

out vec4 fragColor;

void main() {
    vec3 normal = normalize(fNormal);
    vec3 lightDir = normalize(lightPosition - fWorldPos);

    float diff = max(dot(normal, lightDir), 0.0);

    vec3 ambient = lightKa * materialKa * lightColor;
    vec3 diffuse = lightKd * materialKd * diff * lightColor;

    vec3 viewDir = normalize(-fWorldPos);
    vec3 reflectDir = reflect(-lightDir, normal);
    float spec = pow(max(dot(viewDir, reflectDir), 0.0), float(shiny));
    vec3 specular = lightKs * materialKs * spec * lightColor;

    vec4 color;
    if (usaTextura == 1) {
        color = texture(textureData, fTexCoord);
    } else {
        color = fColor;
    }

    fragColor = vec4(color.rgb * (ambient + diffuse + specular), materialAlpha);
}